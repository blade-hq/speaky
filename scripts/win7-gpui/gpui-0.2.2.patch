+fn legacy_font_bounds(face: &IDWriteFontFace) -> [i16; 4] {
+    let mut data = std::ptr::null_mut();
+    let mut size = 0;
+    let mut context = std::ptr::null_mut();
+    let mut exists = BOOL(0);
+    unsafe {
+        if face
+            .TryGetFontTable(
+                u32::from_le_bytes(*b"head"),
+                &mut data,
+                &mut size,
+                &mut context,
+                &mut exists,
+            )
+            .is_err()
+            || !exists.as_bool()
+        {
+            return [0; 4];
+        }
+        let mut result = [0; 4];
+        if size >= 44 && !data.is_null() {
+            let bytes = std::slice::from_raw_parts(data.cast::<u8>().add(36), 8);
+            for (output, value) in result.iter_mut().zip(bytes.chunks_exact(2)) {
+                *output = i16::from_be_bytes([value[0], value[1]]);
+            }
+        }
+        face.ReleaseFontTable(context);
+        result
+    }
